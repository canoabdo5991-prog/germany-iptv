# Normalize the existing file's group title to GERMANY while keeping all existing German entries.
base = base.replace('group-title="Germany"', 'group-title="GERMANY"')

# Avoid duplicating if the user later reuses this file.
content = base.rstrip() + "\n\n" + turkish.strip() + "\n\n" + arabic.strip() + "\n"
out = Path("/mnt/data/Germany_Turkey_Arabic_Merged.m3u")
out.write_text(content, encoding="utf-8")

# Count channels from EXTINF lines.
counts = {}
current = None
for line in content.splitlines():
    if line.startswith("# =============================="):
        current = None
    if 'group-title="GERMANY"' in line:
        counts["GERMANY"] = counts.get("GERMANY", 0) + 1
    elif 'group-title="TURKEY"' in line:
        counts["TURKEY"] = counts.get("TURKEY", 0) + 1
    elif 'group-title="ARABIC"' in line:
        counts["ARABIC"] = counts.get("ARABIC", 0) + 1

print(f"تم إنشاء الملف: {out}")
print(f"عدد القنوات: Germany={counts.get('GERMANY',0)}, Turkey={counts.get('TURKEY',0)}, Arabic={counts.get('ARABIC',0)}")

